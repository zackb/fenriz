# fenriz-desktop's built-in defaults, shipped at
# @FENRIZ_DESKTOP_DATADIR@/fenriz-desktop.conf.
#
# fenriz-desktop reads ~/.config/fenriz/fenriz-desktop.conf and falls back to this
# file when there isn't one. Copy it there to change anything:
#
#   mkdir -p ~/.config/fenriz
#   cp @FENRIZ_DESKTOP_DATADIR@/fenriz-desktop.conf ~/.config/fenriz/
#
# settings: key = value, `#` starts a comment.

# --- Appearance ------------------------------------------------------------

# How opaque the shell's cards are
# behind them, so the transluent
# shell_opacity = 0.80

# --- Wallpaper -------------------------------------------------------------

# Applies to every screen.
wallpaper = @FENRIZ_DESKTOP_DATADIR@/wallpaper.png

# Per-screen override: output_wallpaper = CONNECTOR, PATH
# Connector names are the same ones fenriz uses (`wlr-randr` lists them).
# output_wallpaper = eDP-1, ~/Pictures/laptop.png
# output_wallpaper = DP-1,  ~/Pictures/desk.png

# The directory the wallpaper picker offers, scanned recursively. Unset removes the
# picker and drops its entry from the desktop menu. Open it from the desktop menu, or
# bind it from fenriz.conf with
#   bind = SUPER, W, exec, fenriz-desktop wallpaper
# wallpaper_dir = ~/Pictures/wallpapers

# A picked wallpaper is written to ~/.local/state/fenriz/wallpaper, and it applies to every screen.
# It outranks both keys above, so once you have picked one, editing them here has no visible effect until you
#   rm ~/.local/state/fenriz/wallpaper
# Thumbnails are cached under ~/.cache/fenriz/thumbnails and are safe to delete.

# Run after every wallpaper pick. The new image path is $1 (also in $FENRIZ_WALLPAPER).
# wallpaper_hook = ~/bin/wallpaper-changed.sh "$1"

# `off` drops the picker's search bar and drives the grid with vim keys instead:
# hjkl move, gg and G jump to the first and last, Enter or Space picks, q closes.
# Arrow keys, Escape and the mouse work either way.
# wallpaper_search = on

# --- Launcher --------------------------------------------------------------
# Applications only, ranked by frecency. Bind it from fenriz.conf with
#   bind = SUPER, D, exec, fenriz-desktop launcher
# `off` removes it and drops its entry from the desktop menu.
# launcher = on

# --- Notifications ---------------------------------------------------------
# The org.freedesktop.Notifications daemon every app expects the session to provide.
# notify-send and everything that uses it (low-battery) warning, no "screenshot saved", chat messages.
#
# `off` if you would rather run mako, dunst or swaync.
# notifications = on

# How long a notification lingers, in milliseconds.
# notify_timeout = 5000

# Which corner they stack in: top-left, top-center, top-right, bottom-left, bottom-center, bottom-right.
# notify_position = top-right

# How many past notifications the history panel keeps. Never written to disk, so it
# starts empty every login. `0` keeps none and removes the panel. Bind it from fenriz.conf with
#   bind = SUPER, N, exec, fenriz-desktop notifications
# notify_history = 50

# --- Idle and lock ------------------------------------------------------------
# The three stages fire in order: dim as a warning, then lock, then screens off.
# Set any of them to 0 to disable that stage.
#
# A video player suppresses all three, via either the Wayland idle-inhibit protocol
# or the org.freedesktop.ScreenSaver DBus interface.

# Dim the backlight after this many seconds without input.
# Keep it below idle_lock, or the screen locks before it ever dims.
idle_dim = 300

# Lock after this many seconds without input.
idle_lock = 600

# Switch the screens off after this many seconds without input.
# Input turns them back on. Keep it above idle_lock, or the screens go dark while the session is still unlocked.
idle_dpms = 900

# How dim, as a percent of the panel's maximum. Never 0 — a black panel reads as a
# broken screen rather than an idle one.
# dim_brightness = 10

# Wallpaper blur radius on the lock screen, in pixels.
# lock_blur = 24

# Lock before the machine sleeps: closing the lid, systemctl suspend, low battery. On by default.
# lock_on_suspend = true

# The lock screen authenticates against /etc/pam.d/fenriz-desktop.
# Fingerprint and face are opt-in and each needs its own service file:
#   sudo install -m644 @FENRIZ_DESKTOP_DATADIR@/pam/fenriz-desktop-fprint /etc/pam.d/
#   sudo install -m644 @FENRIZ_DESKTOP_DATADIR@/pam/fenriz-desktop-gaze   /etc/pam.d/

# --- Polkit agent ----------------------------------------------------------
# Registered automatically; nothing to configure. If another authentication
# agent already owns the session, fenriz-desktop logs a warning and skips it.

# --- Desktop context menu --------------------------------------------------
# Right-click the desktop. A Power submenu (Sleep / Log Out / Restart /
# Shut Down) is always present and needs no configuration.

# The terminal the menu offers. Unset means: use $TERMINAL if it is installed,
# otherwise the first of foot, ghostty, kitty, alacritty, wezterm, xterm found
# in PATH. Set it to a full command line if you want arguments.
# terminal = ghostty

# Extra menu items: menu = LABEL, COMMAND. Repeat for as many as you want.
# They appear in the order listed.
#
# menu = Files,      nautilus
# menu = Browser,    firefox
# menu = Screenshot, grim -g "$(slurp)" - | wl-copy
